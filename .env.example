# NSS Connect - Environment Variables
# Copy this file to .env and replace all placeholder values with real ones.
# Do NOT commit .env to version control.

# --- Required: Database (PostgreSQL) ---
# Provision a PostgreSQL database and set the full connection string.
# Example: postgresql://myuser:mypassword@localhost:5432/nss_connect
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Required: Session Security ---
# A random string of at least 32 characters used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# --- Required: Staff Signup Invite Password ---
# A unique secret of at least 15 characters. Used by the staff password-reset flow.
# Share only with trusted staff who will create the first staff accounts.
STAFF_SIGNUP_INVITE_PASSWORD=replace-with-a-unique-secret-at-least-15-characters-long

# --- Optional: Certificate Branding ---
# These appear on generated volunteer certificates.
NSS_COLLEGE_NAME=Bannari Amman Institute of Technology
NSS_UNIT_NAME=National Service Scheme

# --- Optional: Deployment Overrides ---
# PORT is set automatically by Replit/Render; do not override unless self-hosting.
# PORT=5000

# NODE_ENV=production is set automatically on Render; set manually for local prod-like runs.
# NODE_ENV=development

# API_PROXY_TARGET tells the Vite dev server where the API runs (Replit: port 8080).
# Only needed for local development; ignored in production builds.
# API_PROXY_TARGET=http://127.0.0.1:8080

# BASE_PATH is the URL path prefix for the frontend (default: /).
# BASE_PATH=/
